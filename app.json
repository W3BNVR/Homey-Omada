    "port-control": {
      "name": {
        "en": "Omada port control",
        "nl": "Omada-poortbeheer"
      },
      "height": 340,
      "devices": {
        "type": "app",
        "singular": true
      },
      "settings": [],
      "api": {
        "getDevice": {
          "method": "GET",
          "path": "/device/:deviceId"
        },
        "setPoeMode": {
          "method": "PUT",
          "path": "/poe/:deviceType/:siteId/:switchMac/:port"
        },
        "setPortEnabled": {
          "method": "PUT",
          "path": "/port/:siteId/:switchMac/:port"
        },
        "setGatewayWanConnected": {
          "method": "PUT",
          "path": "/wan/:siteId/:switchMac/:port"
        },
        "setMultiPoeMode": {
          "method": "PUT",
          "path": "/poe/:siteId/:switchMac"
        },
        "recoverPoe": {
          "method": "POST",
          "path": "/poe-recovery/:siteId/:switchMac"
        }
      },
      "id": "port-control"
    }
  }
